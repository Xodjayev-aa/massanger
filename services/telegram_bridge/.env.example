# TDLib bridge environment (copy to .env for local runs; production sets these as
# deployment secrets — the bridge reads nothing from a file at runtime).
#
# The bridge shares its trust material with the edge functions: SEAL_KEY must match
# the function's SEAL_KEY and BRIDGE_HMAC_SECRET / BRIDGE_TOKEN must match what
# telegram-ingest / telegram-link / telegram-send are configured with, or every
# wake-up is rejected and nothing is delivered.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ…LEAVE…s…
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.public-anon-key
SUPABASE_JWT_SECRET=the-jwt-secret-of-your-project-32-chars-min

# ── Trust with the edge functions ────────────────────────────────────────────
SEAL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BRIDGE_HMAC_SECRET=at-least-32-random-bytes-shared-with-the-functions
BRIDGE_TOKEN=at-least-32-random-bytes-bearer-token
BRIDGE_BASE_URL=http://bridge.internal:8787
MESSENGERX_ENV=production
LOG_LEVEL=info

# ── Telegram API credentials (my.telegram.org → API development tools) ───────
# One app per deployment; api_hash is the secret, api_id is public by Telegram's
# own convention. Never reuse the app that a public Telegram *bot* uses.
TELEGRAM_API_ID=2941271
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_EXPORT_LOGIN_TOKEN=true
TELEGRAM_QR_TIMEOUT_SECONDS=180

# ── TDLib ────────────────────────────────────────────────────────────────────
# memory   → simulator, no TDLib, no network: the whole pipeline still runs and is
#            what the test-suite and `make bridge` use.
# koffi    → libtdjson loaded in-process (the production default).
# td_ws    → a `tdlib-serve`/`tg_json_client` websocket sidecar at TD_WS_URL.
BRIDGE_TRANSPORT=koffi
TDLIB_LIBRARY_PATH=/usr/local/lib/libtdjson.so
TD_WS_URL=ws://tdlib:8081
TD_VERBOSITY=1
# Encrypts TDLib's own local database per session. Losing it means every linked
# account must re-authenticate through the app: generate once, store in your secret
# manager, and back it up like a TLS key.
TDLIB_DB_KEY=another-32-bytes-secret-used-only-for-tdlib-sqlite
# Persistent volume: one directory per account session, plus the outbound spool.
BRIDGE_DATA_DIR=/var/lib/messengerx-bridge

# ── Loop tuning ──────────────────────────────────────────────────────────────
BRIDGE_MAX_SESSIONS=200
BRIDGE_POLL_INTERVAL_MS=1500
BRIDGE_OUTBOX_BATCH_SIZE=25
BRIDGE_OUTBOX_LEASE_SECONDS=180
BRIDGE_MIN_SEND_INTERVAL_MS=350
BRIDGE_SEND_BURST=6
BRIDGE_HEALTH_PORT=8787
BRIDGE_HEALTH_HOST=0.0.0.0
BRIDGE_WORKER_ID=bridge-1
INGEST_MODE=function
# Only used with BRIDGE_TRANSPORT=memory: a fixed code/password so a scripted
# session can be driven from a test. Never set these in production.
SIM_PHONE_CODE=12345
SIM_PASSWORD=

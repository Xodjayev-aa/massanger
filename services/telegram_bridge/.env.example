# TDLib bridge environment (copy to .env for local runs; `npm run dev` loads it
# with Node's --env-file. Production systemd supplies these from a private
# EnvironmentFile; the bridge itself only reads process.env).
#
# The bridge shares its trust material with the edge functions: SEAL_KEY must match the
# function's SEAL_KEY, and BRIDGE_HMAC_SECRET / BRIDGE_TOKEN must match what
# telegram-ingest / telegram-link / telegram-send are configured with. If they do not,
# every wake-up is rejected and the queue drains only on its poll timer.
#
# Every key below is read by src/config.ts; the value in parentheses is what the
# default is when the key is absent, so the commented lines are optional tuning.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ…LEAVE…s…
# The worker currently does not use an anon key: DB access uses the service-role
# key above, and the ingest function uses BRIDGE_TOKEN + BRIDGE_HMAC_SECRET.
# SUPABASE_ANON_KEY=...

# ── Trust with the edge functions ────────────────────────────────────────────
# 32 bytes, base64url or 64 hex. LINK_PAYLOAD_KEY is the previous name and still works.
SEAL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BRIDGE_HMAC_SECRET=at-least-32-random-bytes-shared-with-the-functions
BRIDGE_TOKEN=***
# Both sides must agree on this label: `production` is what makes the bridge refuse a
# `plain` (unsealed) link payload and refuse an open admin surface. Note the function
# side defaults to production while the worker defaults to development — a worker that
# forgets this key is therefore the one that has to be told.
MESSENGERX_ENV=production
LOG_LEVEL=info

# ── Telegram API credentials (my.telegram.org → API development tools) ───────
# One app per deployment. api_hash is a secret despite the neighbouring name; never
# reuse the app that a public Telegram *bot* uses.
TELEGRAM_API_ID=2941271
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Shown in Telegram's "Devices" list, so make it recognisable to the user.
# TELEGRAM_DEVICE_MODEL=MessengerX Bridge        (default)
# MESSENGERX_VERSION=1.0.0                        (application_version in TDLib)
# TELEGRAM_LANGUAGE_CODE=en                       (system_language_code)
# Session failover needs the persistent BRIDGE_DATA_DIR volume; TDLib does not
# support TELEGRAM_EXPORT_LOGIN_TOKEN (setting it to true fails configuration).
# QR login is not offered by this worker: use the phone + Telegram code flow.
# TELEGRAM_TEST_DC=false            (test DC2 accounts)
# TELEGRAM_SECRET_CHATS=false       (mirroring secret chats needs product sign-off)

# ── TDLib ────────────────────────────────────────────────────────────────────
# memory     → simulator, no TDLib, no network: the whole pipeline still runs, and it
#              is what `npm test` and `make bridge` use.
# koffi      → libtdjson loaded in-process (the default).
# websocket  → requires a separately provisioned, verified TDLib JSON adapter.
#              No third-party sidecar image is bundled or deployed on the $0 path.
# An unrecognised value falls back to koffi, so check /healthz after a change.
BRIDGE_TRANSPORT=koffi
TDLIB_LIBRARY_PATH=/usr/local/lib/libtdjson.so
# TD_WS_URL=ws://<your-verified-adapter>:8081
# TD_VERBOSITY=1                    (raise to 2 while a link is stalling)
# TD_REQUEST_TIMEOUT_MS=45000
# Encrypts TDLib's own local database per session. Losing it means every linked
# account re-authenticates from the app: generate once, keep it in the secret manager,
# back it up like a TLS key. 43..128 characters of base64.
TDLIB_DB_KEY=anothe…lone
# One directory per account session plus the outbound spool; put it on a volume.
BRIDGE_DATA_DIR=/var/lib/messengerx-bridge

# ── Loop tuning ──────────────────────────────────────────────────────────────
# BRIDGE_MAX_SESSIONS=64              (64..4096; shard by user beyond that)
# BRIDGE_POLL_INTERVAL_MS=3000        (queue fallback; the Realtime signal wins)
# BRIDGE_LINK_POLL_MS=1000
# BRIDGE_OUTBOX_BATCH_SIZE=10         (10..200 per tick per user)
# BRIDGE_OUTBOX_LEASE_SECONDS=180     (must exceed the worst-case media send)
# BRIDGE_MIN_SEND_INTERVAL_MS=120     (per-user spacing)
# BRIDGE_MAX_SEND_PER_MINUTE=20       (20..1000; FLOOD_WAIT is parked, not retried)
# BRIDGE_HEARTBEAT_SECONDS=20
# BRIDGE_SESSION_IDLE_SECONDS=600     (idle sessions retire and restart lazily)
# BRIDGE_GRACEFUL_SHUTDOWN_MS=15000
# BRIDGE_MAX_MEDIA_BYTES=26214400
# BRIDGE_MAX_VOICE_SECONDS=300
# BRIDGE_WORKER_ID=bridge-1           (shows up in leases and metrics labels)

# ── Ingest ───────────────────────────────────────────────────────────────────
# function → POST the signed telegram-ingest endpoint (default, and the only mode that
# works on hosted Supabase); rpc → call the RPC with the service-role key directly.
# INGEST_MODE=function
# INGEST_BATCH_SIZE=60                (60..200)
# INGEST_FLUSH_MS=250
# INGEST_TIMEOUT_MS=7500
# CLOCK_SKEW_SECONDS=60               (tolerance on the wake endpoint's HMAC timestamp)
# ALLOWED_ORIGINS=                    (comma list; only guards /internal/wake in browsers)

# ── Admin surface ────────────────────────────────────────────────────────────
BRIDGE_HEALTH_PORT=8787
BRIDGE_HEALTH_HOST=0.0.0.0

# ── Only honoured when BRIDGE_TRANSPORT=memory ───────────────────────────────
# A fixed code/password so a scripted session can be driven from a test or a demo.
# The real transports ignore both keys entirely.
SIM_PHONE_CODE=12345
SIM_PASSWORD=

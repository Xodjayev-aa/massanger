{
  "name": "@messengerx/telegram-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Two-way Telegram ⇄ MessengerX sync worker built on TDLib (personal accounts, not the Bot API).",
  "license": "MIT",
  "engines": { "node": ">=20.11" },
  "main": "dist/main.js",
  "bin": { "messengerx-bridge": "dist/main.js" },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "koffi": "^2.9.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}

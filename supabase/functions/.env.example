# Edge-function environment for local development.
#
#   cp supabase/functions/.env.example supabase/functions/.env.local
#   supabase functions serve --env-file supabase/functions/.env.local
#
# The Supabase CLI loads .env files next to the functions for `functions serve`
# only; in production every value below is a function secret set with
# `supabase secrets set` (see docs/runbook.md §3). Every secret here is a throwaway
# local value — copy nothing from a real deployment into this file.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJhdWQiOiJzdXBhYmFzZS1kZW1vIiwiaWF0IjoxNjQxMDIwODAwLCJleHAiOjE5NTY1ODY4MDB9.local-anon-key-signature-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImF1ZCI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDEwMjA4MDAsImV4cCI6MTk1NjU4NjgwMH0.local-service-key-signature-placeholder
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Google OAuth client ID and secret belong in Supabase Auth's Google provider,
# never in a Flutter build. The edge functions do NOT request Gmail/Drive data.

# ── Bridge ↔ functions trust ─────────────────────────────────────────────────
# SEAL_KEY encrypts the phone/code/password on its way to the bridge. It must be a
# 32-byte value, base64url or 64 hex chars, and identical in the bridge config.
# LINK_PAYLOAD_KEY is the previous name and is still accepted as an alias.
SEAL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BRIDGE_HMAC_SECRET=local-dev-only-hmac-secret-change-me
BRIDGE_TOKEN=local-dev-only-bridge-token-change-me
BRIDGE_BASE_URL=http://host.docker.internal:8787

# ── Hard limits ──────────────────────────────────────────────────────────────
MAX_BODY_BYTES=1572864
INGEST_MAX_EVENTS=120
CLOCK_SKEW_SECONDS=60
ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
MESSENGERX_ENV=development

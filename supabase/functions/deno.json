{
  "lock": false,
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2023", "DOM", "DOM.AsyncIterable"]
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2"
  },
  "tasks": {
    "check": "deno check **/index.ts _shared/*.ts"
  }
}
